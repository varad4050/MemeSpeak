# ==============================================================================
# MemeSpeak — Environment Variables
#
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is in .gitignore.
# ==============================================================================

# --- Database ---
DATABASE_URL=jdbc:postgresql://localhost:5432/memespeak
DATABASE_USERNAME=memespeak
DATABASE_PASSWORD=changeme

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- LLM (Google Gemini Flash / OpenAI) ---
# Gemini Flash on Google AI Studio provides a free tier of 1,500 requests per day (RPD),
# 1M TPM, and 15 RPM.
# Get your API key from Google AI Studio: https://aistudio.google.com/
LLM_API_KEY=your-gemini-api-key-here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash

# Optional: For OpenAI instead
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com
# LLM_MODEL=gpt-4o-mini

# --- Google OAuth2 ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
